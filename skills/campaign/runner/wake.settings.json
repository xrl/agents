{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(cm journal:*)",
      "Bash(cm init:*)",
      "Bash(cm advance:*)",
      "Bash(cm attention:*)",
      "Bash(cm next:*)",
      "Bash(cm lint:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh release view:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Edit(**/LIMITS.toml)",
      "Write(**/LIMITS.toml)",
      "Edit(run/**)",
      "Write(run/**)",
      "Edit(**/run/**)",
      "Write(**/run/**)",
      "Edit(**/.cm/**)",
      "Write(**/.cm/**)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git add -f:*)",
      "Bash(git add --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh api:*)",
      "Bash(cm sync:*)",
      "Bash(cm launch:*)",
      "Bash(cm close:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
